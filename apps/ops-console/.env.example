OPS_CONSOLE_DATABASE_URL=postgresql://ops_console_reader:replace-me@host:5432/database
OPS_CONSOLE_DATABASE_CA_BASE64=
# The authoritative Tree Map database for the free-tree count.
OPS_CONSOLE_TREE_DATABASE_URL=postgresql://ops_console_reader:replace-me@host:5432/defaultdb
# The Tree Map Aiven CA is bundled with the function. Do not add a second
# Base64 certificate environment variable because Netlify Lambda functions have
# a 4 KB environment limit.
OPS_CONSOLE_USER=replace-me
OPS_CONSOLE_PASSWORD=replace-me
OPS_CONSOLE_FRESHNESS_HOURS=72

# Alert when free trees are at or below this number (default 0).
OPS_CONSOLE_MIN_FREE_TREES=0
